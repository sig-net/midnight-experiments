pragma language_version >= 0.25;

import CompactStandardLibrary;
import "@sig-net/midnight/src/Signet";

export ledger signBidirectionalEventMap: SignBidirectionalEventMap<EvmType2TxParams<2, 0, 0>, 34, 34>;
sealed ledger signetSigner: SignetSigner;

constructor(
  signetContract: SignetSigner,
) {
  signetSigner = disclose(signetContract);
}

// One signature request's caller-supplied fields. The sender (kernel.self())
// and the caip2Id (ethereumCaip2Id()) are set by the contract.
export struct BreakRequest {
  requestNonce: Uint<64>;
  keyVersion: Uint<8>;
  path: Bytes<32>;
  algo: MPCSignatureAlgorithm;
  dest: MPCDestination;
  params: Bytes<64>;
  txParamType: TxParamType;
  txParams: EvmType2TxParams<2, 0, 0>;
  outputDeserializationSchema: Bytes<34>;
  respondSerializationSchema: Bytes<34>;
}

circuit constructBreakEvent(
  breakRequest: BreakRequest
): SignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34> {
  return constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    breakRequest.requestNonce,
    breakRequest.keyVersion,
    breakRequest.path,
    breakRequest.algo,
    breakRequest.dest,
    breakRequest.params,
    breakRequest.txParamType,
    breakRequest.txParams,
    ethereumCaip2Id(),
    breakRequest.outputDeserializationSchema,
    breakRequest.respondSerializationSchema
  );
}

// Stores every request unvalidated and notifies the signet contract once per
// request, all in one transaction. requestsPathDepth + requestsPath are the
// notifications' pointer to signBidirectionalEventMap (its "index" in
// compiler/contract-info.json).
export circuit requestSignature(
  breakRequests: Vector<2, BreakRequest>,
  requestsPathDepth: Uint<8>,
  requestsPath: Vector<4, Uint<8>>,
): Vector<2, RequestId> {
  const signEvents = disclose(map(constructBreakEvent, breakRequests));

  for (const signEvent of signEvents) {
    const requestId = calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(signEvent);

    kernel.checkpoint();
    signBidirectionalEventMap.insert(requestId, signEvent);

    signetSigner.signBidirectional(
      requestId,
      constructSignBidirectionalEventNotificationV1(
        kernel.self(),
        disclose(requestsPathDepth),
        disclose(requestsPath),
      ),
    );
  }

  return map(
    (signEvent) => calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(signEvent),
    signEvents
  );
}
